  "search-field": [
    {
      "title": "앱 상단 검색 필드",
      "desc": "검색 화면을 따로 열었을 때는 배경이 채워진 검색 필드 옆에 취소를 배치합니다. 취소를 누르면 이전 화면으로 돌아갑니다.",
      "wide": true,
      "html": "<div class=\"u-full\" style=\"max-width: 375px; padding: var(--ds-space-x2) var(--ds-space-x4)\"><form class=\"ds-searchfield\" role=\"search\" data-variant=\"fill\" action=\"#\"><div class=\"ds-input\" data-variant=\"outline\" data-size=\"medium\"><i class=\"ds-icon ds-icon--search ds-input__icon\" aria-hidden=\"true\"></i><input class=\"ds-input__control\" type=\"search\" name=\"q\" placeholder=\"찾을 낱말을 넣어 주세요\" aria-label=\"찾기\"><button type=\"button\" class=\"ds-input__clear\" aria-label=\"지우기\"></button></div><button type=\"button\" class=\"ds-searchfield__cancel\">취소</button></form></div>"
    },
    {
      "title": "목록 위 필터링",
      "desc": "목록 위 검색 필드는 테두리형으로 표시하고 취소는 두지 않습니다. 글자를 입력하면 지우기 버튼이 나타납니다.",
      "wide": true,
      "html": "<div class=\"u-col u-gap-3 u-full\" style=\"max-width: 420px\">\n  <form class=\"ds-searchfield\" role=\"search\" action=\"#\"><div class=\"ds-input\" data-variant=\"outline\" data-size=\"medium\"><i class=\"ds-icon ds-icon--search ds-input__icon\" aria-hidden=\"true\"></i><input class=\"ds-input__control\" type=\"search\" name=\"q\" placeholder=\"상품 이름으로 찾기\" aria-label=\"찾기\" value=\"텀블러\"><button type=\"button\" class=\"ds-input__clear\" aria-label=\"지우기\"></button></div></form>\n  <ul class=\"ds-list\" data-variant=\"inset\" data-divider><li><div class=\"ds-list-item\"><span class=\"ds-list-item__content\"><span class=\"ds-list-item__title\">스테인리스 텀블러 500ml</span><span class=\"ds-list-item__desc\">18,000원</span></span></div></li></ul>\n</div>"
    }
  ],
